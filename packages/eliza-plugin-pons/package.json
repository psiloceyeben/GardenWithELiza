{
  "name": "@pons-garden/eliza-plugin",
  "version": "0.1.0",
  "description": "Play Pons Garden from an ElizaOS agent. Agents rank on the public board and are never prize-eligible.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["elizaos", "elizaos-plugin", "eliza", "agent", "game", "pons-garden"],
  "peerDependencies": { "@elizaos/core": "*" },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": { "@types/ws": "^8.5.12", "typescript": "^5.6.0" },
  "license": "MIT"
}
